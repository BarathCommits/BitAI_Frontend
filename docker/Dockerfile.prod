# Multi-stage Dockerfile for Production
# Optimized for smallest image size and best performance

# Stage 1: Build
FROM node:18-alpine AS builder

# Install build dependencies
RUN apk add --no-cache python3 make g++ gcc libc-dev

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (production only)
# Use npm install instead of npm ci to handle lock file issues
RUN npm install --legacy-peer-deps --production && \
    npm cache clean --force

# Copy config files
# NOTE: React build tools (react-app-rewired, postcss, tailwind) expect configs at root level
# This follows React conventions - configs are at root in the repository
COPY config-overrides.js ./config-overrides.js
COPY postcss.config.js ./postcss.config.js
COPY tailwind.config.js ./tailwind.config.js
COPY config/tsconfig.json ./tsconfig.json  # TypeScript config stays in /config/ folder

# Copy source
COPY public ./public
COPY src ./src

# Copy or create production env (optional - can be passed via docker-compose env vars)
RUN echo "REACT_APP_API_URL=\${REACT_APP_API_URL}" > .env.production && \
    echo "NODE_ENV=production" >> .env.production

# Build the app
RUN npm run build

# Stage 2: Production
FROM nginx:alpine AS production

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built app from builder stage
COPY --from=builder /app/build /usr/share/nginx/html

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80/health || exit 1

# Create health endpoint
RUN echo '{"status":"healthy"}' > /usr/share/nginx/html/health

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

