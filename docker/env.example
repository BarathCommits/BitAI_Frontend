# BitAI Frontend Docker Environment Configuration

# ===========================================
# External Backend API Configuration
# ===========================================

# Point to your separate backend service
REACT_APP_API_URL=http://localhost:3001/api/v1
REACT_APP_AUTH_URL=http://localhost:3001/api/auth
REACT_APP_WS_URL=ws://localhost:3001

# ===========================================
# AI Provider API Keys (Client-side)
# ===========================================

# Hugging Face (Free tier available)
REACT_APP_HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Google Gemini (Free tier available)
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# Cohere (Free tier available)
REACT_APP_COHERE_API_KEY=your_cohere_api_key_here

# Anthropic Claude (Paid service)
REACT_APP_CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI (Alternative - if needed)
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# Frontend Application Configuration
# ===========================================

# Environment
NODE_ENV=development
PORT=3001

# ===========================================
# AI Model Configuration
# ===========================================

# Default AI Provider (huggingface, gemini, cohere, claude)
REACT_APP_DEFAULT_AI_PROVIDER=huggingface

# AI Model Settings
REACT_APP_AI_MAX_TOKENS=2048
REACT_APP_AI_TEMPERATURE=0.7
REACT_APP_AI_MAX_RETRIES=3
REACT_APP_AI_TIMEOUT=30000

# ===========================================
# Web3 Configuration - Solana Only
# ===========================================

# Default Chain ID (Solana Mainnet)
REACT_APP_DEFAULT_CHAIN_ID=101

# Supported Chains (Solana only)
REACT_APP_SUPPORTED_CHAINS=101,103,102

# Solana RPC URLs
REACT_APP_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
REACT_APP_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
REACT_APP_SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com

# ===========================================
# Feature Flags
# ===========================================

# Enable/disable features
REACT_APP_ENABLE_AI_CHAT=true
REACT_APP_ENABLE_DAPP_STORE=true
REACT_APP_ENABLE_PORTFOLIO=true
REACT_APP_ENABLE_VAULT=true
REACT_APP_DEBUG=true
REACT_APP_USE_REAL_API=true

# ===========================================
# Development Configuration
# ===========================================

# Development server
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3001

# Hot reload
FAST_REFRESH=true
