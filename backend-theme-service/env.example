# Server Configuration
PORT=3002
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/safe-theme-service
MONGODB_TEST_URI=mongodb://localhost:27017/safe-theme-service-test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Theme Service Configuration
THEME_CACHE_TTL=3600
THEME_DEFAULT_ID=default-cyberpunk
THEME_MAX_CUSTOM_THEMES=10

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Health Check
HEALTH_CHECK_INTERVAL=30000

