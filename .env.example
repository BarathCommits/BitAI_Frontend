# SafeBrowser Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api/v1
REACT_APP_WS_URL=ws://localhost:3001

# AI Provider API Keys
REACT_APP_HUGGINGFACE_API_KEY=your_huggingface_api_key_here
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here
REACT_APP_COHERE_API_KEY=your_cohere_api_key_here
REACT_APP_CLAUDE_API_KEY=your_claude_api_key_here

# Web3 Configuration
REACT_APP_DEFAULT_CHAIN_ID=1
REACT_APP_SUPPORTED_CHAINS=1,137,56,42161

# Feature Flags
REACT_APP_ENABLE_AI_CHAT=true
REACT_APP_ENABLE_DAPP_STORE=true
REACT_APP_ENABLE_PORTFOLIO=true
REACT_APP_ENABLE_ANALYTICS=true

# Development
REACT_APP_ENVIRONMENT=development
REACT_APP_DEBUG=true

# Production URLs (uncomment for production)
# REACT_APP_API_URL=https://api.safebrowser.io/api/v1
# REACT_APP_WS_URL=wss://api.safebrowser.io
# REACT_APP_ENVIRONMENT=production
# REACT_APP_DEBUG=false
